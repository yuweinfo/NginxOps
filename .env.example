# =====================================================
# NginxOps 环境变量配置
# 复制此文件为 .env 并修改配置值
# =====================================================

# PostgreSQL 数据库配置
POSTGRES_DB=nginxops
POSTGRES_USER=nginxops
POSTGRES_PASSWORD=nginxops123

# JWT 密钥 (至少32个字符)
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
